<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/menuProgress"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_stat_card"
    android:padding="16dp"

    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/iconProgress"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_revise_svg"
        app:tint="#00897B"
        android:layout_centerVertical="true"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_toEndOf="@id/iconProgress"
        android:text="Study History"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:layout_centerVertical="true"/>

    <ImageView
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_rightarr_svg"/>

</RelativeLayout>
