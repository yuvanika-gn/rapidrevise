<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="85dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bg_stat_card"
    android:layout_marginBottom="15dp"
    android:padding="16dp">

    <FrameLayout
        android:id="@+id/iconKey"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_icon_pink"
        android:layout_centerVertical="true"
        android:padding="12dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_bulb_svg"
            app:tint="#ffffff"/>
    </FrameLayout>

    <LinearLayout
        android:layout_toEndOf="@id/iconKey"
        android:layout_marginStart="16dp"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Key Concepts"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8 essential concepts summarized"
            android:textSize="13sp"
            android:textColor="#7A7A7A"/>
    </LinearLayout>

    <ImageView
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_rightarr_svg"/>
</RelativeLayout>
