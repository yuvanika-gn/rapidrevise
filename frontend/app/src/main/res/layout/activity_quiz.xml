<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA">

    <!-- 🔥 TOP GRADIENT HEADER -->
    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/bg_quiz_gradient"/>

    <!-- 🔥 CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 🔥 PROGRESS -->
            <TextView
                android:id="@+id/tvProgress"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="Question 1 of 10"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="10dp"
                android:progress="30"
                android:max="100"
                android:progressTint="#FFFFFF"
                android:progressBackgroundTint="#40FFFFFF"/>

            <!-- 🔥 FLOATING QUESTION CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                app:cardCornerRadius="28dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Question"
                        android:textSize="13sp"
                        android:textColor="#888"/>

                    <TextView
                        android:id="@+id/tvQuestion"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 🔥 OPTIONS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical">

                <!-- OPTION ITEM STYLE -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOption1"
                    style="@style/QuizOptionPremium"
                    app:cardBackgroundColor="@color/white">

                    <TextView
                        android:id="@+id/option1"
                        style="@style/QuizOptionTextPremium"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOption2"
                    style="@style/QuizOptionPremium"
                    app:cardBackgroundColor="@color/white">

                    <TextView
                        android:id="@+id/option2"
                        style="@style/QuizOptionTextPremium"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOption3"
                    style="@style/QuizOptionPremium"
                    app:cardBackgroundColor="@color/white">

                    <TextView
                        android:id="@+id/option3"
                        style="@style/QuizOptionTextPremium"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardOption4"
                    style="@style/QuizOptionPremium"
                    app:cardBackgroundColor="@color/white">

                    <TextView
                        android:id="@+id/option4"
                        style="@style/QuizOptionTextPremium"/>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- 🔥 NEXT BUTTON -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:text="Next"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="17sp"
        android:background="@drawable/bg_primary_button"
        android:elevation="10dp"/>

    <!-- 🔥 LOADING OVERLAY (FULL SCREEN BLOCKER) -->
    <RelativeLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3FFFFFF"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <!-- Center box -->
        <LinearLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_loading_card"
            android:elevation="10dp">

            <ProgressBar
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:indeterminate="true"
                android:indeterminateTint="#4CAF50"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Loading..."
                android:textSize="14sp"
                android:textColor="#333"/>
        </LinearLayout>

    </RelativeLayout>

</RelativeLayout>