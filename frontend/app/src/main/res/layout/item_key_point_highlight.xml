<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardKeyPointImportant"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_keypoint_highlight"
    android:padding="18dp"
    android:layout_marginBottom="16dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Conservation of Energy"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:textStyle="bold"/>

    <ImageView
        android:id="@+id/btnStar"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_star_fill"
        app:tint="#F9A825"/>

    <TextView
        android:id="@+id/tvKeyPoint"
        android:layout_below="@id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Energy cannot be created or destroyed..."
        android:textSize="14sp"
        android:textColor="#555555"
        android:layout_marginTop="10dp"/>
</RelativeLayout>
